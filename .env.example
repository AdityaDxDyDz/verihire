# VeriHire - all settings (copy to .env; .env is git-ignored). Owner of this file in the plan: Kadam - merge his deploy
# settings here. Defaults below run everything locally with no cloud account and no API key.

# ---- app (backend/app/config.py) -------------------------------------------------------------------------------
APP_ENV=development            # development | test | production
AUTH_MODE=dev                  # dev (Bearer dev:<email>) | supabase  - dev is refused in production
STORAGE_MODE=local             # local | supabase
ML_MODE=auto                   # auto | stub | real  - production MUST be real (startup fails otherwise)
LOG_LEVEL=INFO
LOG_JSON=true
APP_SECRET=change-me           # production: random, >= 32 characters (signs local PDF links)

# ---- database ---------------------------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verihire   # Supabase: use the POOLER connection string
AUTO_MIGRATE=false             # true = apply db/migrations at startup (safe, idempotent)

# ---- Supabase (production) --------------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=             # public by design (frontend login)
SUPABASE_SERVICE_KEY=          # SERVER ONLY - never in git, never in the frontend
STORAGE_BUCKET=resumes
LOCAL_STORAGE_DIR=.data/storage

# ---- LLM (Track C) - without a key the rule-based StubLLM is used and /health says so -----------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5      # JD parsing
LLM_MODEL_STRONG=claude-sonnet-5-5   # skill-gap analysis
# check https://docs.claude.com for current model ids before the demo

# ---- embeddings (Track B) ---------------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384              # frozen: the database column is vector(384)
FASTEMBED_CACHE_PATH=.cache/fastembed
VERIHIRE_EMBED_OFFLINE=0       # 1 = never download (model must already be cached / baked into the image)

# ---- limits & tuning --------------------------------------------------------------------------------------------
MAX_PDF_MB=10
MAX_FILES_PER_REGISTER=100
INGEST_CONCURRENCY=2           # workers; PDF extraction itself is serialised (PyMuPDF is not thread-safe)
INGEST_TIMEOUT_S=60
RERANK_POOL=50                 # must equal Track C's training top_k (50)
LLM_RATE_LIMIT_PER_MIN=20
ANALYSIS_TIMEOUT_S=90
JD_PARSE_TIMEOUT_S=45
PDF_URL_TTL_S=300
FRONTEND_DIR=frontend          # Kadam's static frontend, served by the backend from the same origin
CORS_ORIGINS=                  # empty = same origin only
